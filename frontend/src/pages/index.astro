---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Your organization">
  <div class="title-band">
    <fieldset class="seg lang-switch" aria-describedby="language-hint">
      <legend class="visually-hidden">Language</legend>
      <p class="visually-hidden" id="language-hint">Questions and your report can be in English or Spanish.</p>
      <div class="seg__opts">
        <label class="seg__opt"><input type="radio" name="language" value="en" checked><span class="seg__check" aria-hidden="true"><Icon name="check" /></span><span>English</span></label>
        <label class="seg__opt"><input type="radio" name="language" value="es"><span class="seg__check" aria-hidden="true"><Icon name="check" /></span><span lang="es">Español</span></label>
      </div>
    </fieldset>
    <span class="eyebrow">Step 1 of 3: Your organization</span>
    <h1 id="page-title" tabindex="-1">Tell us about your organization</h1>
    <p class="lead">You will answer Yes or No to short statements about how your organization works today. It takes about <span id="time-total">11 minutes</span> for the areas you pick below, and you can stop and come back later.</p>
    <noscript><p class="notice"><Icon name="info" /><span>This page needs JavaScript. Turn it on in your browser settings, then reload the page.</span></p></noscript>
    <div class="notice draft-resume" id="draft-resume" hidden></div>
    <p class="resume-cta"><a href="/resume/"><Icon name="refresh" /><span>Continue an assessment you started</span></a></p>
  </div>

  <section class="how" aria-labelledby="how-title">
    <h2 id="how-title" class="mini-label">How it works</h2>
    <details class="m-more" open>
      <summary>How it works: 3 steps<Icon name="chevron-down" class="m-more__chevron" /></summary>
      <ol class="how__steps" role="list">
        <li><span class="how__icon" aria-hidden="true"><Icon name="clipboard" /></span><span><strong>1. Answer</strong> Yes or No to each statement. There are no wrong answers.</span></li>
        <li><span class="how__icon" aria-hidden="true"><Icon name="chart" /></span><span><strong>2. We score it</strong> with a fixed method. The same answers always give the same stages.</span></li>
        <li><span class="how__icon" aria-hidden="true"><Icon name="target" /></span><span><strong>3. You get a plan:</strong> 1 or 2 growth priorities to start with, a 12-week roadmap and a PDF to share.</span></li>
      </ol>
    </details>
  </section>

  <div class="error-summary" id="error-summary" tabindex="-1" aria-labelledby="error-summary-title" hidden>
    <h2 id="error-summary-title"><Icon name="alert" />There is a problem</h2>
    <ul id="error-list"></ul>
  </div>

  <form class="stack" id="org-form" novalidate>
    <section class="card stack" aria-labelledby="respondent-title" aria-describedby="respondent-hint">
      <h2 id="respondent-title" class="org-meta__title">Who is filling this out?</h2>
      <p class="hint" id="respondent-hint">Someone in a leadership role should fill this out. It can be the executive director, a finance lead, a board chair, or another leader.</p>
      <fieldset class="field" data-field="respondent_role">
        <legend>Your role</legend>
        <p class="field-error" id="respondent_role-error" hidden></p>
        <div class="choice-row" id="role-options"><p class="loading"><Icon name="loader" class="spin" />Loading</p></div>
      </fieldset>
      <div class="field" data-field="respondent_title">
        <label for="resp_title">Your job title</label>
        <p class="field-error" id="respondent_title-error" hidden></p>
        <input class="input" type="text" id="resp_title" name="resp_title" autocomplete="organization-title" autocapitalize="words" enterkeyhint="go" maxlength="100" required>
      </div>
      <div class="field" data-field="respondent_name">
        <label for="resp_name">Your name</label>
        <p class="hint" id="resp_name-hint">Shown only on your own report. We never send your name to the AI.</p>
        <p class="field-error" id="respondent_name-error" hidden></p>
        <input class="input" type="text" id="resp_name" name="resp_name" autocomplete="name" autocapitalize="words" spellcheck="false" enterkeyhint="go" maxlength="100" required aria-describedby="resp_name-hint">
      </div>
    </section>

    <section class="card stack" aria-labelledby="org-title">
      <h2 id="org-title" class="org-meta__title">Your organization</h2>
      <div class="field" data-field="org_name">
        <label for="org_name">Organization name</label>
        <p class="field-error" id="org_name-error" hidden></p>
        <input class="input" type="text" id="org_name" name="org_name" autocomplete="organization" autocapitalize="words" enterkeyhint="go" maxlength="200" required>
      </div>

      <details class="m-more" id="more-links" open>
        <summary>Add your website and social media (optional)<Icon name="chevron-down" class="m-more__chevron" /></summary>
        <div class="stack">
          <div class="field" data-field="org_url">
            <label for="org_url">Website <span class="optional">(optional)</span></label>
            <p class="hint" id="org_url-hint">We read your public website so your plan fits your work. For example: https://example.org</p>
            <p class="field-error" id="org_url-error" hidden></p>
            <input class="input" type="url" id="org_url" name="org_url" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" enterkeyhint="go" maxlength="500" aria-describedby="org_url-hint">
          </div>

          <fieldset class="field" data-field="social" id="social" aria-describedby="social-hint">
            <legend>Social media links <span class="optional">(optional, up to 5)</span></legend>
            <p class="hint" id="social-hint">For example, Facebook or Instagram, or any web address. We read these and look for news stories about your group. What we find only changes the wording of your plan, never your scores.</p>
            <p class="field-error" id="social-error" hidden></p>
            <ul class="social-links" id="social-list" role="list"></ul>
            <button type="button" class="btn btn-secondary btn-sm" id="social-add"><Icon name="plus" /><span>Add a social media link</span></button>
          </fieldset>
        </div>
      </details>
    </section>

    <section class="card stack" aria-labelledby="about-org-title" aria-describedby="about-org-hint">
      <h2 id="about-org-title" class="org-meta__title">More about your organization</h2>
      <p class="hint" id="about-org-hint">This helps us fit your plan to your work and connect you with groups like yours. It does not change your scores.</p>
      <details class="m-more" id="more-org" open>
        <summary>Add details (optional): programs, staff size, budget, state<Icon name="chevron-down" class="m-more__chevron" /></summary>
        <div id="org-meta" class="stack"><p class="loading"><Icon name="loader" class="spin" />Loading</p></div>
      </details>
    </section>

    <fieldset class="card stack" id="domains" data-field="domains" aria-describedby="domains-hint">
      <legend class="legend-heading">Which capacity areas do you want to look at?</legend>
      <p class="hint" id="domains-hint">The four areas marked Recommended are a good place to start. Add or remove any.</p>
      <p class="field-error" id="domains-error" hidden></p>
      <div id="domain-groups"><p class="loading"><Icon name="loader" class="spin" />Loading capacity areas</p></div>
    </fieldset>

    <p class="notice"><Icon name="shield" /><span>Do not enter personal information about staff or participants. Your answers are used only to build this report.</span></p>

    <div class="actions">
      <button type="submit" class="btn btn-primary"><span>Start questionnaire</span><Icon name="arrow-right" /></button>
    </div>

    <details class="card samples" id="samples" hidden>
      <summary class="samples__summary"><Icon name="sprout" /><span>Try a made-up sample organization</span></summary>
      <p class="hint" id="samples-hint">For demos and staff training. These organizations are made up, and their answers are filled in for you. We use the report language and areas you picked above. Each sample makes a new report, which takes about a minute.</p>
      <ul class="samples__list" id="sample-list" role="list"></ul>
      <p class="field-error" id="samples-error" role="alert" hidden></p>
    </details>
  </form>
  <script is:inline>
    // Phones: optional groups start folded, before first paint. Wider screens hide their summaries and keep them open.
    if (matchMedia("(max-width: 599px)").matches) document.querySelectorAll("details.m-more").forEach(function (d) { d.open = false; });
  </script>
</Base>

<script>
  import { api, ApiError, getMeta, requireUser, type Domain } from "../lib/api";
  import { $, $$, announce, esc, focusEl, plural } from "../lib/dom";
  import { icon } from "../lib/icons";
  import { loadDraft, saveDraft, SECONDS_PER_STATEMENT, type OrgMeta, type Respondent } from "../lib/draft";

  const form = $<HTMLFormElement>("#org-form")!;
  const nameEl = $<HTMLInputElement>("#org_name")!;
  const urlEl = $<HTMLInputElement>("#org_url")!;
  const titleEl = $<HTMLInputElement>("#resp_title")!;
  const personEl = $<HTMLInputElement>("#resp_name")!;
  const socialList = $("#social-list")!;
  const socialAdd = $<HTMLButtonElement>("#social-add")!;
  const summary = $("#error-summary")!;
  const list = $("#error-list")!;
  const baseTitle = document.title;
  const MAX_SOCIAL = 5;
  const URL_ERROR = "Enter a full web address, like https://example.org, or leave it blank";
  const SOCIAL_ERROR = "Enter each social media link as a full web address, like https://instagram.com/yourgroup, or remove it";
  // Phones fold optional groups (details.m-more). Wider screens hide their summaries, so a group folded on a phone opens there.
  const phone = matchMedia("(max-width: 599px)");
  phone.addEventListener("change", () => { if (!phone.matches) $$<HTMLDetailsElement>("details.m-more").forEach((d) => { d.open = true; }); });

  type Field = "respondent_role" | "respondent_title" | "respondent_name" | "org_name" | "org_url" | "social" | "domains";
  const FIELDS: Field[] = ["respondent_role", "respondent_title", "respondent_name", "org_name", "org_url", "social", "domains"];
  // Groups of controls: the error is described on the fieldset, and the summary links to the first control.
  const GROUPS = new Set<Field>(["respondent_role", "social", "domains"]);
  const describedBase: Record<Field, string> = { respondent_role: "", respondent_title: "", respondent_name: "resp_name-hint", org_name: "", org_url: "org_url-hint", social: "social-hint", domains: "domains-hint" };
  const socialInputs = () => $$<HTMLInputElement>("input", socialList);
  const badSocial = () => socialInputs().filter((i) => normalizeUrl(i.value) === null);
  const targets: Record<Field, () => HTMLElement | null> = {
    respondent_role: () => $<HTMLInputElement>("input[name=respondent_role]"),
    respondent_title: () => titleEl,
    respondent_name: () => personEl,
    org_name: () => nameEl,
    org_url: () => urlEl,
    social: () => badSocial()[0] ?? socialAdd,
    domains: () => $<HTMLInputElement>("input[name=domains]"),
  };
  function setError(field: Field, msg: string | null) {
    const err = $(`#${field}-error`)!;
    const wrap = $(`[data-field=${field}]:not(li)`)!; // not the error summary's item, which shares the attribute
    const control = GROUPS.has(field) ? wrap : targets[field]()!;
    wrap.classList.toggle("field--error", !!msg);
    if (field === "social") {
      const bad = new Set(msg ? badSocial() : []);
      socialInputs().forEach((i) => { if (bad.has(i)) i.setAttribute("aria-invalid", "true"); else i.removeAttribute("aria-invalid"); });
    }
    if (msg) {
      const fold = wrap.closest("details");
      if (fold) fold.open = true; // an error inside a folded group: show it
      err.innerHTML = `${icon("alert")}<span>${esc(msg)}</span>`;
      err.hidden = false;
      if (!GROUPS.has(field)) control.setAttribute("aria-invalid", "true");
      control.setAttribute("aria-describedby", `${describedBase[field]} ${field}-error`.trim());
    } else {
      err.hidden = true;
      // A fixed field leaves the summary; the summary goes once nothing is left in it.
      list.querySelector(`[data-field="${field}"]`)?.remove();
      if (!summary.hidden && !list.children.length) { summary.hidden = true; document.title = baseTitle; }
      control.removeAttribute("aria-invalid");
      if (describedBase[field]) control.setAttribute("aria-describedby", describedBase[field]); else control.removeAttribute("aria-describedby");
    }
  }

  function normalizeUrl(raw: string): string | null {
    const v = raw.trim();
    if (!v) return "";
    const withScheme = /^https?:\/\//i.test(v) ? v : `https://${v}`;
    try {
      const u = new URL(withScheme);
      return u.hostname.includes(".") ? u.href : null;
    } catch { return null; }
  }

  const chosen = () => $$<HTMLInputElement>("input[name=domains]:checked").map((b) => b.value);
  const language = () => ($<HTMLInputElement>("input[name=language]:checked")?.value === "es" ? "es" : "en") as "en" | "es";
  const role = () => $<HTMLInputElement>("input[name=respondent_role]:checked")?.value ?? null;
  const socialLinks = () => [...new Set(socialInputs().map((i) => normalizeUrl(i.value)).filter((u): u is string => !!u))];

  function validate(): Partial<Record<Field, string>> {
    const errors: Partial<Record<Field, string>> = {};
    if (!role()) errors.respondent_role = "Choose your role";
    if (!titleEl.value.trim()) errors.respondent_title = "Enter your job title";
    if (!personEl.value.trim()) errors.respondent_name = "Enter your name";
    if (!nameEl.value.trim()) errors.org_name = "Enter your organization's name";
    if (normalizeUrl(urlEl.value) === null) errors.org_url = URL_ERROR;
    if (badSocial().length) errors.social = SOCIAL_ERROR;
    if (!chosen().length) errors.domains = "Choose at least one capacity area";
    return errors;
  }

  function showErrors(errors: Partial<Record<Field, string>>) {
    FIELDS.forEach((f) => setError(f, errors[f] ?? null));
    const entries = FIELDS.filter((f) => errors[f]).map((f): [Field, string] => [f, errors[f]!]);
    if (!entries.length) { summary.hidden = true; return; }
    list.innerHTML = entries.map(([f, msg]) => `<li data-field="${f}"><a href="#${targets[f]()?.id ?? f}">${esc(msg)}</a></li>`).join("");
    summary.hidden = false;
    summary.setAttribute("role", "alert");
    document.title = `Check your answers: Your organization · OCI Capacity Coach`;
    focusEl(summary);
  }

  list.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest("a");
    if (!a) return;
    e.preventDefault();
    const el = document.getElementById(a.getAttribute("href")!.slice(1));
    el?.scrollIntoView({ block: "center" });
    el?.focus();
  });

  // Clear a field's error as soon as it is fixed; new errors still wait for blur or submit, never a keystroke.
  nameEl.addEventListener("input", () => { if (nameEl.value.trim()) setError("org_name", null); });
  titleEl.addEventListener("input", () => { if (titleEl.value.trim()) setError("respondent_title", null); });
  personEl.addEventListener("input", () => { if (personEl.value.trim()) setError("respondent_name", null); });
  urlEl.addEventListener("input", () => { if (normalizeUrl(urlEl.value) !== null) setError("org_url", null); });
  urlEl.addEventListener("blur", () => setError("org_url", normalizeUrl(urlEl.value) === null ? URL_ERROR : null));
  socialList.addEventListener("focusout", () => {
    if (!$("#social-error")!.hidden) setError("social", badSocial().length ? SOCIAL_ERROR : null);
  });

  /** One input per link, each with a visible label and its own Remove button; focus follows every add or remove. */
  function renderSocial(values: string[]) {
    socialList.innerHTML = values.map((v, i) => `
      <li class="social-links__item">
        <label for="social-${i}">Link ${i + 1}</label>
        <div class="input-group">
          <input class="input" type="url" id="social-${i}" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" enterkeyhint="go" maxlength="500" value="${esc(v)}">
          <button type="button" class="btn btn-secondary btn-sm social-links__remove" data-remove="${i}" aria-label="Remove link ${i + 1}">${icon("x")}<span class="social-links__remove-text" aria-hidden="true">Remove</span></button>
        </div>
      </li>`).join("");
    socialAdd.hidden = values.length >= MAX_SOCIAL;
  }

  socialAdd.addEventListener("click", () => {
    const values = [...socialInputs().map((i) => i.value), ""];
    renderSocial(values);
    socialInputs()[values.length - 1]?.focus();
    announce(`Link ${values.length} added.`);
  });

  socialList.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-remove]");
    if (!btn) return;
    const at = Number(btn.dataset.remove);
    const values = socialInputs().map((i) => i.value).filter((_, i) => i !== at);
    renderSocial(values);
    if (!$("#social-error")!.hidden) setError("social", badSocial().length ? SOCIAL_ERROR : null);
    (socialInputs()[Math.min(at, values.length - 1)] ?? socialAdd).focus();
    announce(`Link ${at + 1} removed.`);
  });

  const areaMinutes = (d: Domain) => Math.max(1, Math.ceil((d.questions.length * SECONDS_PER_STATEMENT) / 60));

  /** Checkbox cards with a "Recommended" tag (Airwallex "Primary interest"), statement count and time estimate. */
  function renderDomains(domains: Domain[], selected: string[]) {
    const card = (d: Domain) => `
      <li class="area-option">
        <label class="choice area-option__card">
          <input type="checkbox" name="domains" value="${esc(d.id)}" id="domain-${esc(d.id)}" ${selected.includes(d.id) ? "checked" : ""}>
          <span class="choice__text">
            <span class="area-option__name">${esc(d.name)}${d.priority ? ' <span class="tag">Recommended</span>' : ""}</span>
            <span class="choice__meta">${d.questions.length} statements, about ${plural(areaMinutes(d), "minute", "minutes")}</span>
          </span>${icon("check", "choice__check")}
        </label>
        <details class="about"><summary>About ${esc(d.name)}</summary><p>${esc(d.about)}</p></details>
      </li>`;
    const rest = domains.filter((d) => !d.priority);
    // Phones fold the areas not marked Recommended, unless one of them is picked.
    const open = !phone.matches || rest.some((d) => selected.includes(d.id));
    $("#domain-groups")!.innerHTML = `<ul class="area-options" role="list">${domains.filter((d) => d.priority).map(card).join("")}</ul>`
      + (rest.length ? `<details class="m-more area-more" ${open ? "open" : ""}><summary>More areas you can add: ${esc(rest.map((d) => d.name).join(", "))}${icon("chevron-down", "m-more__chevron")}</summary>
        <ul class="area-options" role="list">${rest.map(card).join("")}</ul></details>` : "");
    // The intro's time estimate is the sum of the area estimates, so the two always agree.
    const total = () => {
      const mins = domains.filter((d) => chosen().includes(d.id)).map(areaMinutes);
      const lo = Math.min(...domains.map(areaMinutes)), hi = Math.max(...domains.map(areaMinutes));
      // No area picked: give the per-area range, never "0 minutes".
      $("#time-total")!.textContent = mins.length ? plural(mins.reduce((s, m) => s + m, 0), "minute", "minutes") : lo === hi ? `${plural(lo, "minute", "minutes")} each` : `${lo} to ${hi} minutes each`;
    };
    total();
    $("#domains")!.addEventListener("change", () => { total(); if (chosen().length) setError("domains", null); });
  }

  interface MetaOptions {
    program_models: string[]; staff_sizes: string[]; budgets: string[]; respondent_roles: string[];
    states: { code: string; name: string }[];
  }

  function renderRoles(roles: string[], saved: string | null | undefined) {
    $("#role-options")!.innerHTML = roles.map((r, i) => `
      <label class="choice"><input type="radio" name="respondent_role" id="role-${i}" value="${esc(r)}" ${saved === r ? "checked" : ""}>
        <span class="choice__text">${esc(r)}</span>${icon("check", "choice__check")}</label>`).join("");
    $("#role-options")!.addEventListener("change", () => setError("respondent_role", null));
  }

  const radios = (name: string, options: [string, string][], saved: string) => options.map(([v, label]) => `
    <label class="choice"><input type="radio" name="${name}" value="${esc(v)}" ${saved === v ? "checked" : ""}>
      <span class="choice__text">${esc(label)}</span>${icon("check", "choice__check")}</label>`).join("");

  /** Not required, so "Prefer not to say" is the default; program model and size tailor the plan and peer groups. */
  function renderOrgMeta(o: MetaOptions, saved: OrgMeta | null | undefined) {
    const skip: [string, string] = ["", "Prefer not to say"];
    $("#org-meta")!.innerHTML = `
      <fieldset class="field">
        <legend>What does your organization do? <span class="optional">(pick all that apply)</span></legend>
        <div class="choice-row">${o.program_models.map((m) => `
          <label class="choice"><input type="checkbox" name="program_models" value="${esc(m)}" ${saved?.program_models.includes(m) ? "checked" : ""}>
            <span class="choice__text">${esc(m)}</span>${icon("check", "choice__check")}</label>`).join("")}
        </div>
      </fieldset>
      <fieldset class="field">
        <legend>How many staff do you have?</legend>
        <div class="choice-row org-meta__sizes">${radios("staff_size", [skip, ...o.staff_sizes.map((s): [string, string] => [s, `${s} staff`])], saved?.staff_size ?? "")}</div>
      </fieldset>
      <fieldset class="field">
        <legend>What is your yearly budget?</legend>
        <div class="choice-row org-meta__sizes">${radios("budget", [skip, ...o.budgets.map((b): [string, string] => [b, b])], saved?.budget ?? "")}</div>
      </fieldset>
      <fieldset class="field" aria-describedby="states-hint">
        <legend>States or territories <span class="optional">(optional, up to ${MAX_STATES})</span></legend>
        <p class="hint" id="states-hint">Add each state or territory where you work.</p>
        <ul class="state-picks" id="state-list" role="list"></ul>
        <div class="state-add" id="state-add">
          <label for="org-state">Add a state or territory</label>
          <div class="input-group">
            <select class="input" id="org-state">
              <option value="">Choose one</option>
              ${o.states.map((s) => `<option value="${esc(s.code)}">${esc(s.name)}</option>`).join("")}
            </select>
            <button type="button" class="btn btn-secondary" id="state-add-btn">${icon("plus")}<span>Add</span></button>
          </div>
        </div>
      </fieldset>`;
    wireStates(o.states, saved?.states ?? []);
  }

  /** Issue #23: several states or territories. A select plus an Add button (adding on change would add every state a
   *  keyboard user arrows past), the chosen ones as chips with their own remove button (#31), focus kept on a control. */
  const MAX_STATES = 10;
  let pickedStates: string[] = [];
  function wireStates(all: { code: string; name: string }[], saved: string[]) {
    const name = new Map(all.map((s) => [s.code, s.name]));
    const sel = $<HTMLSelectElement>("#org-state")!;
    const list = $("#state-list")!;
    const render = () => {
      list.innerHTML = pickedStates.map((c) => `
        <li class="state-picks__item"><span>${esc(name.get(c)!)}</span>
          <button type="button" class="state-picks__remove" data-state-remove="${esc(c)}" aria-label="Remove ${esc(name.get(c)!)}">${icon("x")}</button></li>`).join("");
      for (const opt of sel.options) opt.disabled = !!opt.value && pickedStates.includes(opt.value);
      $("#state-add")!.hidden = pickedStates.length >= MAX_STATES;
    };
    pickedStates = saved.filter((c) => name.has(c)).slice(0, MAX_STATES);
    render();
    $("#state-add-btn")!.addEventListener("click", () => {
      if (!sel.value) { sel.focus(); announce("Choose a state or territory first."); return; }
      pickedStates.push(sel.value);
      const added = name.get(sel.value);
      sel.value = "";
      render();
      (pickedStates.length < MAX_STATES ? sel : $$<HTMLButtonElement>("[data-state-remove]", list).at(-1))?.focus();
      announce(`${added} added. ${plural(pickedStates.length, "state or territory", "states or territories")} chosen.`);
    });
    list.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-state-remove]");
      if (!btn) return;
      const at = pickedStates.indexOf(btn.dataset.stateRemove!);
      pickedStates.splice(at, 1);
      render();
      const next = $$<HTMLButtonElement>("[data-state-remove]", list);
      (next[Math.min(at, next.length - 1)] ?? sel).focus();
      announce(`${name.get(btn.dataset.stateRemove!)} removed.`);
    });
  }

  function orgMeta(): OrgMeta | null {
    const m: OrgMeta = {
      program_models: $$<HTMLInputElement>("input[name=program_models]:checked").map((b) => b.value),
      staff_size: $<HTMLInputElement>("input[name=staff_size]:checked")?.value || null,
      budget: $<HTMLInputElement>("input[name=budget]:checked")?.value || null,
      // A state picked but not yet added still counts, so nothing chosen is lost on submit.
      states: [...new Set([...pickedStates, $<HTMLSelectElement>("#org-state")?.value || ""])].filter(Boolean),
    };
    return m.program_models.length || m.staff_size || m.budget || m.states.length ? m : null;
  }

  const respondent = (): Respondent => ({ role: role(), title: titleEl.value.trim() || null, name: personEl.value.trim() || null });

  async function init() {
    await requireUser();
    const [meta, options, draft] = await Promise.all([getMeta(), api.get<MetaOptions>("/org-meta"), loadDraft()]);
    nameEl.value = draft?.org_name ?? "";
    urlEl.value = draft?.org_url ?? "";
    titleEl.value = draft?.respondent?.title ?? "";
    personEl.value = draft?.respondent?.name ?? "";
    if (draft?.language === "es") $<HTMLInputElement>("input[name=language][value=es]")!.checked = true;
    renderSocial(draft?.org_links?.social.length ? draft.org_links.social.slice(0, MAX_SOCIAL) : [""]);
    const known = new Set(meta.domains.map((d) => d.id));
    const selected = draft?.domain_ids.filter((id) => known.has(id)).length ? draft.domain_ids : meta.default_domains;
    renderRoles(options.respondent_roles, draft?.respondent?.role);
    renderDomains(meta.domains, selected);
    renderOrgMeta(options, draft?.org_meta);
    // Saved values never sit in a folded group.
    const unfold: [string, unknown][] = [["more-links", urlEl.value || draft?.org_links?.social.length], ["more-org", draft?.org_meta]];
    for (const [id, has] of unfold) if (has) $<HTMLDetailsElement>(`#${id}`)!.open = true;
    // Sent back from the questionnaire because the server rejected these details (for example a draft saved before the
    // job title and name were required): show what to fix right away. Answers stay saved.
    if (new URLSearchParams(location.search).has("check")) showErrors(validate());

    // A half-finished assessment on this device: say so, so nobody starts over by mistake.
    const mine = meta.domains.filter((d) => draft?.domain_ids.includes(d.id)).flatMap((d) => d.questions);
    const done = mine.filter((q) => draft?.answers[q.id]).length;
    if (draft?.org_name && done) {
      const box = $("#draft-resume")!;
      box.innerHTML = `${icon("clock")}<p>You have answers saved on this device for <strong></strong>: ${done} of ${plural(mine.length, "statement", "statements")}. <a href="/questionnaire/">Continue where you left off</a></p>`;
      box.querySelector("strong")!.textContent = draft.org_name;
      box.hidden = false;
    }

    if (meta.samples.length) {
      $("#sample-list")!.innerHTML = meta.samples.map((s) => `
        <li><button type="button" class="btn btn-secondary sample-btn" data-sample="${esc(s.id)}" aria-describedby="samples-hint">
          <span class="sample-btn__name">${esc(s.name)}</span><span class="sample-btn__summary">${esc(s.summary)}</span>
        </button></li>`).join("");
      $("#samples")!.hidden = false;
      // Opening the sample section marks this browser as a demo, which shows the questionnaire's
      // "Demo: fill this area with sample answers" button (demo login only).
      $("#samples")!.addEventListener("toggle", () => {
        if (($("#samples") as HTMLDetailsElement).open) { try { localStorage.setItem("oci-demo-preload", "1"); } catch { /* private mode */ } }
      });
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const errors = validate();
      showErrors(errors);
      if (Object.keys(errors).length) return;
      const social = socialLinks();
      saveDraft({
        org_name: nameEl.value.trim(),
        org_url: normalizeUrl(urlEl.value) || "",
        language: language(),
        domain_ids: meta.domains.map((d) => d.id).filter((id) => chosen().includes(id)),
        answers: draft?.answers ?? {},
        org_meta: orgMeta(),
        respondent: respondent(),
        org_links: social.length ? { social } : null,
        view: draft?.view, // #28: how they chose to answer, so editing these details does not ask again
      });
      location.assign("/questionnaire/");
    });

    let starting = false; // one sample report at a time: each one costs money and counts against the hourly cap
    $("#sample-list")!.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-sample]");
      if (!btn || starting) return;
      const errEl = $("#samples-error")!;
      if (!chosen().length) { showErrors({ domains: "Choose at least one capacity area" }); return; }
      starting = true;
      $$("[data-sample]").forEach((b) => b.setAttribute("aria-disabled", "true"));
      errEl.hidden = true;
      announce("Starting the sample report.");
      try {
        const { id } = await api.post<{ id: string }>("/demo", { sample: btn.dataset.sample, language: language(), domain_ids: chosen() });
        location.assign(`/results/?id=${encodeURIComponent(id)}`);
      } catch (ex) {
        if (ex instanceof ApiError && ex.status === 401) { location.assign("/login/?next=%2F"); return; }
        const msg = ex instanceof ApiError && ex.body.error ? ex.body.error
          : ex instanceof ApiError ? "Something went wrong on our side. Please try again in a few minutes."
          : "We could not reach the server. Check your internet connection, then try again.";
        errEl.innerHTML = `${icon("alert")}<span>${esc(msg)}</span>`;
        errEl.hidden = false;
        starting = false;
        $$("[data-sample]").forEach((b) => b.removeAttribute("aria-disabled"));
      }
    });
  }

  init().catch(() => {
    // Nothing below can work without the areas and options: say so once, and stop the loading spinners.
    for (const sel of ["#role-options", "#org-meta"]) $(sel)!.innerHTML = "";
    $("#domain-groups")!.innerHTML = `<p class="field-error" role="alert">${icon("alert")}<span>We could not load this page. Check your internet connection, then reload the page.</span></p>`;
  });
</script>
