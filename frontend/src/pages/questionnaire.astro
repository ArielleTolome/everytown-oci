---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Questionnaire">
  <div id="q-root" aria-busy="true">
    <p class="loading"><Icon name="loader" class="spin" />Loading your questionnaire</p>
  </div>
</Base>

<script>
  import { api, ApiError, getMeta, requireUser, type Domain, type Question, type Stage } from "../lib/api";
  import { $, $$, esc, focusEl, plural } from "../lib/dom";
  import { icon } from "../lib/icons";
  import { clearDraft, loadDraft, saveDraft, type Draft } from "../lib/draft";

  const root = $("#q-root")!;
  let draft: Draft;
  let domains: Domain[] = [];
  let stages: Stage[] = [];
  let missing = new Set<string>();
  let submitting = false;
  let barObserver: ResizeObserver | null = null;

  const stepFromHash = () => {
    const n = parseInt(location.hash.slice(1), 10);
    return Number.isFinite(n) && n >= 1 && n <= domains.length ? n : 1;
  };
  const totalQuestions = () => domains.reduce((s, d) => s + d.questions.length, 0);
  const answeredTotal = () => domains.reduce((s, d) => s + d.questions.filter((q) => draft.answers[q.id]).length, 0);
  const isComplete = (d: Domain) => d.questions.every((q) => draft.answers[q.id]);

  /** Area stepper (Stitch status cards; Turo/OKX step patterns). Completed areas link back only when every earlier area is complete too. */
  function stepper(n: number): string {
    let reachable = true;
    return domains.map((d, i) => {
      const cur = i === n - 1;
      const done = isComplete(d);
      const canLink = !cur && done && reachable;
      reachable = reachable && done;
      const state = cur ? "current" : done ? "done" : "upcoming";
      const label = cur ? "In progress" : done ? "Completed" : "Upcoming";
      const mark = state === "done" ? icon("check") : `<span>${i + 1}</span>`;
      const inner = `<span class="area-card__mark" aria-hidden="true">${mark}</span>
        <span class="area-card__text"><span class="area-card__state">${label}</span><span class="area-card__name">${i + 1}. ${esc(d.name)}</span></span>`;
      return `<li class="area-card is-${state}"${cur ? ' aria-current="step"' : ""}>${canLink ? `<a href="#${i + 1}">${inner}</a>` : `<span class="area-card__body">${inner}</span>`}</li>`;
    }).join("");
  }

  function statementCard(q: Question, num: number): string {
    const miss = missing.has(q.id);
    return `
      <fieldset class="question${miss ? " field--error" : ""}" id="q-${esc(q.id)}"${miss ? ` aria-describedby="${esc(q.id)}-error"` : ""}>
        <legend><span class="question__num">${num}.</span> ${esc(q.text)}</legend>
        ${miss ? `<p class="field-error" id="${esc(q.id)}-error">${icon("alert")}<span>Please choose Yes or No.</span></p>` : ""}
        <div class="answer-row">${(["yes", "no"] as const).map((v) => `
          <label class="answer">
            <input type="radio" name="${esc(q.id)}" value="${v}" id="${esc(q.id)}-${v}" required ${draft.answers[q.id] === v ? "checked" : ""}>
            <span class="answer__text">${v === "yes" ? "Yes" : "No"}</span>
            <span class="answer__tag" aria-hidden="true">${icon("check")}Selected</span>
          </label>`).join("")}
        </div>
      </fieldset>`;
  }

  /** Statements grouped under stage subheadings, numbered within the area. */
  function groupedStatements(d: Domain): string {
    let num = 0;
    const order = [...new Set(d.questions.map((q) => q.stage))].sort((a, b) => a - b);
    return order.map((n) => {
      const st = stages.find((s) => s.n === n);
      const qs = d.questions.filter((q) => q.stage === n);
      const id = `stage-${d.id}-${n}`;
      return `<section class="stage-group" aria-labelledby="${id}">
        <div class="stage-group__head">
          <h2 id="${id}"><span class="stage-badge">Stage ${n}</span> ${esc(st?.name ?? qs[0].stage_name)}</h2>
          ${st?.description ? `<p class="stage-group__desc">${esc(st.description)}</p>` : ""}
        </div>
        ${qs.map((q) => statementCard(q, ++num)).join("")}
      </section>`;
    }).join("");
  }

  function render(n: number, moveFocus: boolean) {
    const d = domains[n - 1];
    const last = n === domains.length;
    const here = d.questions.filter((q) => missing.has(q.id));
    const nextName = last ? "" : domains[n].name;
    document.title = `${here.length ? "Check your answers: " : ""}${d.name} (${n} of ${domains.length}) · OCI Capacity Coach`;

    root.innerHTML = `
      <div class="title-band">
        <span class="eyebrow">Step 2 of 3: Questionnaire</span>
        <h1 id="area-title" tabindex="-1">${esc(d.name)}</h1>
      </div>
      <nav aria-label="Capacity areas" class="area-stepper"><ol role="list">${stepper(n)}</ol></nav>
      <div id="draft-tools" data-area="${esc(d.id)}"></div>
      <div class="q-progress">
        <p class="q-progress__where"><span class="dot" aria-hidden="true"></span>Area ${n} of ${domains.length}${last ? " · Last area" : ` · Next: ${esc(nextName)}`}</p>
        <label for="overall-progress" class="q-progress__label" id="progress-text"></label>
        <progress id="overall-progress" max="${totalQuestions()}" value="0"></progress>
      </div>
      <details class="about-card">
        <summary>${icon("info")}<span>About this area: why ${esc(d.name)} matters</span>${icon("chevron-down", "about-card__chevron")}</summary>
        <div class="about-card__body"><p>${esc(d.about)}</p>${d.connects ? `<p>${esc(d.connects)}</p>` : ""}</div>
      </details>
      <div class="callout">
        <span class="callout__icon" aria-hidden="true">${icon("shield")}</span>
        <div><p class="callout__title">There are no wrong answers</p>
        <p>Choose Yes if the statement describes how your organization works today, and No if it does not yet. Every No is simply a place to grow.</p></div>
      </div>
      ${here.length ? `
      <div class="error-summary" id="error-summary" role="alert" tabindex="-1" aria-labelledby="error-summary-title">
        <h2 id="error-summary-title">${icon("alert")}Please answer ${plural(here.length, "more statement", "more statements")}</h2>
        <ul>${here.map((q) => `<li><a href="#${esc(q.id)}-yes" data-jump>${esc(q.text)}</a></li>`).join("")}</ul>
      </div>` : ""}
      <p class="hint">All ${d.questions.length} statements are required. Your answers are saved on this device as you go.</p>
      <form id="area-form" novalidate>
        <div class="questions">${groupedStatements(d)}</div>
        <p class="field-error" id="submit-error" role="alert" hidden></p>
        <div class="q-bar" id="q-bar">
          <button type="button" class="btn btn-secondary" id="back-btn">${icon("arrow-left")}<span class="q-bar__back-label">Back${n === 1 ? '<span class="visually-hidden"> to your organization</span>' : ""}</span></button>
          <p class="q-bar__status" id="save-status" role="status" aria-live="polite">${icon("circle-check")}<span>Saved on this device</span></p>
          <button type="submit" class="btn btn-primary" id="next-btn"><span>${last ? "See my results" : `Next: ${esc(nextName)}`}</span>${icon("arrow-right")}</button>
        </div>
      </form>`;
    root.removeAttribute("aria-busy");
    updateProgress();
    watchBar();

    const form = $<HTMLFormElement>("#area-form")!;
    form.addEventListener("change", (e) => {
      const input = e.target as HTMLInputElement;
      if (input.type !== "radio") return;
      draft.answers[input.name] = input.value as "yes" | "no";
      saveDraft(draft);
      missing.delete(input.name);
      const fs = input.closest<HTMLElement>(".question");
      if (fs?.classList.contains("field--error")) {
        fs.classList.remove("field--error");
        fs.removeAttribute("aria-describedby");
        fs.querySelector(".field-error")?.remove();
      }
      updateProgress();
      const done = d.questions.filter((q) => draft.answers[q.id]).length;
      // One polite status message (the bar's own live region), not a competing second region.
      $("#save-status span")!.textContent = `Saved on this device. ${done} of ${d.questions.length} answered in this area.`;
    });
    form.addEventListener("submit", (e) => { e.preventDefault(); next(n); });
    $("#back-btn")!.addEventListener("click", () => {
      if (n === 1) location.assign("/"); else location.hash = String(n - 1);
    });
    $$<HTMLAnchorElement>("[data-jump]").forEach((a) => a.addEventListener("click", (e) => {
      e.preventDefault();
      const el = document.getElementById(a.getAttribute("href")!.slice(1));
      el?.closest(".question")?.scrollIntoView({ block: "center" });
      el?.focus({ preventScroll: true });
    }));

    if (here.length) focusEl($("#error-summary"));
    else if (moveFocus) { window.scrollTo(0, 0); focusEl($("#area-title")); }
  }

  /** Keep scroll-padding equal to the sticky bar so focused controls are never hidden behind it (WCAG 2.4.11). */
  function watchBar() {
    const bar = $("#q-bar");
    barObserver?.disconnect();
    if (!bar) return;
    const set = () => document.documentElement.style.setProperty("--qbar-h", `${Math.ceil(bar.getBoundingClientRect().height)}px`);
    set();
    barObserver = new ResizeObserver(set);
    barObserver.observe(bar);
  }

  // Fallback for browsers that ignore scroll-padding when moving focus: nudge the page if the bar covers the focused control.
  document.addEventListener("focusin", (e) => {
    const bar = $("#q-bar");
    const el = e.target as HTMLElement;
    if (!bar || bar.contains(el)) return;
    const target = el.closest(".answer") ?? el;
    const overlap = target.getBoundingClientRect().bottom - bar.getBoundingClientRect().top + 12;
    if (overlap > 0) window.scrollBy({ top: overlap });
  });

  function updateProgress() {
    const a = answeredTotal(), t = totalQuestions();
    const pct = t ? Math.round((a / t) * 100) : 0;
    const bar = $<HTMLProgressElement>("#overall-progress");
    if (bar) { bar.value = a; bar.textContent = `${pct}%`; }
    const txt = $("#progress-text");
    if (txt) txt.textContent = `${a} of ${t} statements answered (${pct}%)`;
  }

  async function next(n: number) {
    const d = domains[n - 1];
    const unanswered = d.questions.filter((q) => !draft.answers[q.id]).map((q) => q.id);
    if (unanswered.length) {
      unanswered.forEach((id) => missing.add(id));
      render(n, false);
      return;
    }
    if (n < domains.length) { location.hash = String(n + 1); return; }
    if (submitting) return;
    submitting = true;
    const btn = $<HTMLButtonElement>("#next-btn")!;
    btn.setAttribute("aria-disabled", "true");
    btn.querySelector("span")!.textContent = "Submitting";
    try {
      const { id } = await api.post<{ id: string }>("/assessments", {
        org_name: draft.org_name, org_url: draft.org_url, language: draft.language,
        domain_ids: draft.domain_ids, answers: draft.answers,
      });
      // Keep the organization details for next time; answers start fresh.
      clearDraft();
      saveDraft({ ...draft, answers: {} });
      location.assign(`/results/?id=${encodeURIComponent(id)}`);
    } catch (ex) {
      submitting = false;
      if (ex instanceof ApiError && ex.status === 400 && ex.body.missing?.length) {
        missing = new Set(ex.body.missing);
        ex.body.missing.forEach((id) => { delete draft.answers[id]; });
        saveDraft(draft);
        const first = domains.findIndex((x) => x.questions.some((q) => missing.has(q.id))) + 1;
        if (first >= 1 && String(first) !== location.hash.slice(1)) location.hash = String(first);
        else render(first || n, false);
        return;
      }
      if (ex instanceof ApiError && ex.status === 400 && ex.body.errors) {
        // Organization details were rejected: send the person back to fix them.
        location.assign("/");
        return;
      }
      btn.removeAttribute("aria-disabled");
      btn.querySelector("span")!.textContent = "See my results";
      const err = $("#submit-error")!;
      err.innerHTML = `${icon("alert")}<span>We could not submit your answers. They are saved on this device. Please try again.</span>`;
      err.hidden = false;
    }
  }

  async function init() {
    await requireUser();
    const meta = await getMeta();
    const d = await loadDraft();
    if (!d || !d.org_name || !d.domain_ids.length) { location.replace("/"); return; }
    draft = d;
    stages = meta.stages;
    domains = d.domain_ids.map((id) => meta.domains.find((x) => x.id === id)).filter((x): x is Domain => !!x);
    if (!domains.length) { location.replace("/"); return; }
    if (!location.hash) history.replaceState(null, "", "#1");
    render(stepFromHash(), false);
    // Only numeric hashes are steps; the skip link (#main) must not re-render the page.
    window.addEventListener("hashchange", () => { if (/^#\d+$/.test(location.hash)) render(stepFromHash(), true); });
  }

  init().catch(() => {
    root.removeAttribute("aria-busy");
    root.innerHTML = `<h1>Questionnaire</h1><p class="field-error" role="alert">${icon("alert")}<span>We could not load the questions. Please reload the page.</span></p>`;
  });
</script>
