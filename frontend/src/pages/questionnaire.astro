---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Questionnaire">
  <div id="q-root" aria-busy="true">
    <p class="loading"><Icon name="loader" class="spin" />Loading your questionnaire</p>
    <noscript><p class="notice"><Icon name="info" /><span>The questionnaire needs JavaScript. Turn it on in your browser settings, then reload the page.</span></p></noscript>
  </div>
</Base>

<script>
  import { api, ApiError, getMeta, requireUser, type Domain, type Question, type Stage } from "../lib/api";
  import { $, $$, esc, focusEl, plural } from "../lib/dom";
  import { icon } from "../lib/icons";
  import { clearDraft, DraftLinkError, draftToken, loadDraft, saveDraft, savedLocally, SECONDS_PER_STATEMENT, type Draft } from "../lib/draft";
  import { mountQuick, scopeLadders, type Ladder } from "../lib/quick";

  const root = $("#q-root")!;
  let draft: Draft;
  let domains: Domain[] = [];
  let stages: Stage[] = [];
  let missing = new Set<string>();
  let submitting = false;
  let barObserver: ResizeObserver | null = null;
  type View = "quick" | "yn" | "check";
  const VIEW_KEY = "oci-q-view";
  const DEMO_KEY = "oci-demo-preload";
  // One at a time is the default on a first visit; a chosen view is remembered.
  let view: View = "quick";
  try { const v = localStorage.getItem(VIEW_KEY); if (v === "yn" || v === "check") view = v; } catch { /* storage disabled */ }
  let ladders: Ladder[] = [];
  let byId = new Map<string, { q: Question; area: string }>();
  let quick: { goTo(id: string): void } | null = null;
  let current: Domain | null = null; // area on screen, for the time-left line
  let demo = false; // demo preload button: demo user plus ?demo=1 (remembered on this device)
  let sampleAnswers: Promise<Record<string, "yes" | "no"> | null> | null = null;
  // shortcut: question language is not saved; a reload falls back to the report language. Persist it if people ask.
  let qlang: "en" | "es" = "en";
  let glossary: { term: string; plain: string; example: string; re: RegExp }[] = [];
  let es: Record<string, { text: string; about?: string; connects?: string }> = {};
  let keyed = ""; // set by a Y/N shortcut so the save status says what was chosen

  // Encouragement written by us, not by AI: shown once when an area becomes fully answered.
  const CHEER: Record<string, string> = {
    PL: "Planning done. Thank you for being honest, that is what makes the plan useful.",
    FR: "Fundraising done. Knowing where you stand is the first step to steadier funding.",
    GV: "Governance done. Honest answers like these help your board grow with you.",
    HR: "Human Resources done. Your team is your biggest strength. Thank you for looking closely.",
    FM: "Financial Management done. Clear answers here help you protect the work you do.",
    ML: "Monitoring, Learning and Evaluation done. You are already learning from your own work.",
    CE: "Community Engagement done. Your ties to the community are what make this work possible.",
    TI: "Technology done. Thank you. Even small tools can save your team real time.",
  };
  const cheerFor = (d: Domain) => CHEER[d.id] ?? `${d.name} done. Thank you for your honest answers.`;

  const spanish = () => qlang === "es";
  const textOf = (q: Question) => (spanish() && es[q.id]?.text) || q.text;
  // New v1.7 interface text follows the question language (same pattern as lib/quick.ts); `sp` is trusted HTML.
  const tr = (en: string, sp: string) => (spanish() ? `<span lang="es">${sp}</span>` : en);
  const stmt = (q: Question) => `<span${spanish() ? ' lang="es"' : ""}>${esc(textOf(q))}</span>`;
  const noState = (id: string) => (draft.answers[id] === "no" ? "Counted as No" : "");

  /** Spanish: English original. English: plain-language help for up to 2 glossary terms in the statement. */
  function helpFor(q: Question): string {
    if (spanish()) return `<details class="q-help" lang="es"><summary>Ver el original en inglés</summary><p lang="en">${esc(q.text)}</p></details>`;
    return glossary.filter((g) => g.re.test(q.text)).slice(0, 2).map((g) => `
      <details class="q-help"><summary>What does '${esc(g.term)}' mean?</summary><p>${esc(g.plain)}</p><p>${esc(g.example)}</p></details>`).join("");
  }

  const stepFromHash = () => {
    const n = parseInt(location.hash.slice(1), 10);
    return Number.isFinite(n) && n >= 1 && n <= domains.length ? n : 1;
  };
  const totalQuestions = () => domains.reduce((s, d) => s + d.questions.length, 0);
  const answeredTotal = () => domains.reduce((s, d) => s + d.questions.filter((q) => draft.answers[q.id]).length, 0);
  const isComplete = (d: Domain) => d.questions.every((q) => draft.answers[q.id]);

  /** Area stepper (Stitch status cards; Turo/OKX step patterns). Completed areas link back only when every earlier area is complete too. */
  function stepper(n: number): string {
    let reachable = true;
    return domains.map((d, i) => {
      const cur = i === n - 1;
      const done = isComplete(d);
      const canLink = !cur && done && reachable;
      reachable = reachable && done;
      const state = cur ? "current" : done ? "done" : "upcoming";
      // An area left part way (a teammate's, or one answered on another device) says so instead of "Upcoming".
      const started = !done && d.questions.some((q) => draft.answers[q.id]);
      const label = done ? "Completed" : cur ? "In progress" : started ? "Started" : "Upcoming";
      const mark = done ? icon("check") : `<span>${i + 1}</span>`;
      const inner = `<span class="area-card__mark" aria-hidden="true">${mark}</span>
        <span class="area-card__text"><span class="area-card__state">${label}</span><span class="area-card__name">${i + 1}. ${esc(d.name)}</span></span>`;
      return `<li class="area-card is-${state}${started && !cur ? " is-started" : ""}"${cur ? ' aria-current="step"' : ""}>${canLink ? `<a href="#${i + 1}">${inner}</a>` : `<span class="area-card__body">${inner}</span>`}</li>`;
    }).join("");
  }

  function statementCard(q: Question, num: number): string {
    const miss = missing.has(q.id);
    return `
      <fieldset class="question${miss ? " field--error" : ""}" id="q-${esc(q.id)}"${miss ? ` aria-describedby="${esc(q.id)}-error"` : ""}>
        <legend><span class="question__num">${num}.</span> ${stmt(q)}</legend>
        ${miss ? `<p class="field-error" id="${esc(q.id)}-error">${icon("alert")}<span>Please choose Yes or No.</span></p>`
          : draft.answers[q.id] ? "" : `<p class="q-pending" id="${esc(q.id)}-pending">${icon("circle-dashed")}<span>Not answered yet</span></p>`}
        ${helpFor(q)}
        <div class="answer-row">${(["yes", "no"] as const).map((v) => `
          <label class="answer">
            <input type="radio" name="${esc(q.id)}" value="${v}" id="${esc(q.id)}-${v}" required ${draft.answers[q.id] === v ? "checked" : ""}>
            <span class="answer__text">${v === "yes" ? "Yes" : "No"}</span>
            <span class="answer__tag" aria-hidden="true">${icon("check")}Selected</span>
          </label>`).join("")}
        </div>
      </fieldset>`;
  }

  /** Checklist view: ticked = "yes"; unticking records "no"; untouched stays unanswered until the Done button. */
  function checklistItem(q: Question, num: number): string {
    const id = esc(q.id);
    return `
      <li class="check-item" id="q-${id}">
        <label class="check-item__row">
          <input type="checkbox" id="${id}-check" data-q="${id}"${draft.answers[q.id] === "yes" ? " checked" : ""} aria-describedby="${id}-state${q.reverse ? ` ${id}-rev` : ""}">
          <span class="check-item__text"><span class="question__num">${num}.</span> ${stmt(q)}</span>
        </label>
        ${q.reverse ? `<p class="check-item__note" id="${id}-rev">${icon("info")}<span>Ticking this one counts as a growth priority.</span></p>` : ""}
        <p class="check-item__state" id="${id}-state">${noState(q.id)}</p>
        ${helpFor(q)}
      </li>`;
  }

  /** Statements grouped under stage subheadings, numbered within the area. */
  function groupedStatements(d: Domain): string {
    let num = 0;
    const order = [...new Set(d.questions.map((q) => q.stage))].sort((a, b) => a - b);
    return order.map((n) => {
      const st = stages.find((s) => s.n === n);
      const qs = d.questions.filter((q) => q.stage === n);
      const id = `stage-${d.id}-${n}`;
      return `<section class="stage-group" aria-labelledby="${id}">
        <div class="stage-group__head">
          <h2 id="${id}"><span class="stage-badge">Stage ${n}</span> ${esc(st?.name ?? qs[0].stage_name)}</h2>
          ${st?.description ? `<p class="stage-group__desc">${esc(st.description)}</p>` : ""}
        </div>
        ${view === "check" ? `<ul class="tick-list" role="list">${qs.map((q) => checklistItem(q, ++num)).join("")}</ul>` : qs.map((q) => statementCard(q, ++num)).join("")}
      </section>`;
    }).join("");
  }

  function render(n: number, moveFocus: boolean) {
    const d = domains[n - 1];
    current = d;
    const last = n === domains.length;
    const here = d.questions.filter((q) => missing.has(q.id));
    const nextName = last ? "" : domains[n].name;
    document.title = `${here.length ? "Check your answers: " : ""}${d.name} (${n} of ${domains.length}) · OCI Capacity Coach`;

    // One at a time: the card comes right after the progress line; the view and language switches, area info and
    // tips move below it, so the first statement is on the first screen (also on a phone).
    const quickView = view === "quick";
    const context = `
      <details class="about-card">
        <summary>${icon("info")}<span>About this area: why ${esc(d.name)} matters</span>${icon("chevron-down", "about-card__chevron")}</summary>
        <div class="about-card__body" id="about-body"></div>
      </details>
      <div class="callout">
        <span class="callout__icon" aria-hidden="true">${icon("shield")}</span>
        <div><p class="callout__title">There are no wrong answers</p>
        <p id="callout-text"></p></div>
      </div>`;
    const tips = `
      <details class="about-card kbd-tips">
        <summary>${icon("type")}<span>Keyboard tips</span>${icon("chevron-down", "about-card__chevron")}</summary>
        <div class="about-card__body"><ul>
          <li>In One at a time view, press Y for Yes or N for No. The next statement comes up by itself. Press the left arrow to go back one.</li>
          <li>Press Tab to move from one statement to the next.</li>
          <li>In Yes / No view, press Y for Yes or N for No while you are on a statement. The arrow keys also move between Yes and No.</li>
          <li>In the checklist, press Space to tick or untick a statement.</li>
        </ul></div>
      </details>
      <p class="hint">Answer all ${d.questions.length} statements to finish this area. We save your answers on this device as you go.</p>`;
    const tools = `
      <div class="q-tools">
        <fieldset class="seg" aria-describedby="view-hint"><legend id="view-legend"></legend><div class="seg__opts">
          ${seg("q-view", "quick", "One at a time", view === "quick")}${seg("q-view", "yn", "Yes / No for each", view === "yn")}${seg("q-view", "check", "Checklist: tick what's true", view === "check")}
        </div><p class="hint seg__hint" id="view-hint"></p></fieldset>
        ${es[d.questions[0].id] ? `<fieldset class="seg"><legend>Questions in</legend><div class="seg__opts">
          ${seg("q-lang", "en", "English", !spanish())}${seg("q-lang", "es", '<span lang="es">Español</span>', spanish())}
        </div></fieldset>` : ""}
      </div>
      ${demo ? `<p class="q-demo"><button type="button" class="q-demo__btn" id="demo-fill">${icon("clipboard")}<span>Demo: fill this area with sample answers</span></button></p>` : ""}`;
    // Save and share are secondary in One at a time view, so they follow the card there; a teammate keeps the notice
    // about which area they answer on top.
    const draftTools = `<div id="draft-tools" data-area="${esc(d.id)}"></div>`;
    const toolsBelow = quickView && !new URLSearchParams(location.search).has("area");
    root.dataset.view = view;
    root.innerHTML = `
      <div class="title-band">
        <span class="eyebrow">Step 2 of 3: Questionnaire</span>
        <h1 id="area-title" tabindex="-1">${esc(d.name)}</h1>
      </div>
      <nav aria-label="Capacity areas" class="area-stepper"><ol role="list">${stepper(n)}</ol></nav>
      ${toolsBelow ? "" : draftTools}
      <div class="q-progress">
        <p class="q-progress__where">Area ${n} of ${domains.length}. ${last ? "This is the last area." : `Next: ${esc(nextName)}`}</p>
        <label for="overall-progress" class="q-progress__label" id="progress-text"></label>
        <progress id="overall-progress" max="${totalQuestions()}" value="0"></progress>
        <p class="q-progress__meta"><span class="q-progress__time" id="time-left"></span><span class="q-streak" id="area-streak" hidden></span></p>
      </div>
      ${quickView ? "" : context}
      ${here.length ? `
      <div class="error-summary" id="error-summary" role="alert" tabindex="-1" aria-labelledby="error-summary-title">
        <h2 id="error-summary-title">${icon("alert")}Please answer ${plural(here.length, "more statement", "more statements")}</h2>
        <ul>${here.map((q) => `<li><a href="#q-${esc(q.id)}" data-jump="${esc(q.id)}"${spanish() ? ' lang="es"' : ""}>${esc(textOf(q))}</a></li>`).join("")}</ul>
      </div>` : ""}
      ${quickView ? "" : tools + tips}
      <form id="area-form" novalidate>
        <div class="questions" id="questions"></div>
        ${quickView ? (toolsBelow ? draftTools : "") + tools + context + tips : ""}
        <p class="field-error" id="submit-error" role="alert" hidden></p>
        <div class="q-bar" id="q-bar">
          <button type="button" class="btn btn-secondary" id="back-btn">${icon("arrow-left")}<span class="q-bar__back-label">Back${n === 1 ? '<span class="visually-hidden"> to your organization</span>' : ""}</span></button>
          <p class="q-bar__status" id="save-status" role="status" aria-live="polite">${icon("circle-check")}<span class="q-bar__full">Saved on this device</span>${shortStatus(d)}</p>
          <button type="submit" class="btn btn-primary" id="next-btn">${last ? "<span>Review and finish</span>" : nextHtml(nextName)}${icon("arrow-right")}</button>
        </div>
      </form>`;
    root.removeAttribute("aria-busy");
    fillQuestions(d);
    updateProgress();
    watchBar();

    $(".q-tools")!.addEventListener("change", (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name === "q-view") {
        view = input.value as View;
        try { localStorage.setItem(VIEW_KEY, view); } catch { /* storage disabled */ }
        // The layout depends on the view: re-render, then put focus back on the chosen option.
        render(n, false);
        $<HTMLInputElement>('input[name="q-view"]:checked')?.focus();
        return;
      }
      qlang = input.value === "es" ? "es" : "en";
      fillQuestions(d);
    });
    const form = $<HTMLFormElement>("#area-form")!;
    form.addEventListener("change", (e) => {
      const input = e.target as HTMLInputElement;
      const id = input.type === "radio" ? input.name : input.dataset.q;
      // Only this area's statements are answers: in One at a time view the view and language switches sit in this form too.
      if (!id || !d.questions.some((q) => q.id === id)) return;
      const wasComplete = isComplete(d);
      draft.answers[id] = input.type === "radio" ? (input.value as "yes" | "no") : input.checked ? "yes" : "no";
      saveDraft(draft);
      missing.delete(id);
      const fs = input.closest<HTMLElement>(".question");
      if (fs?.classList.contains("field--error")) {
        fs.classList.remove("field--error");
        fs.removeAttribute("aria-describedby");
        fs.querySelector(".field-error")?.remove();
      }
      document.getElementById(`${id}-pending`)?.remove();
      const state = document.getElementById(`${id}-state`);
      if (state) state.textContent = noState(id);
      saved(d, wasComplete, keyed);
      keyed = "";
    });
    // Y / N on a focused Yes/No statement (WCAG 2.1.4: single-key shortcuts only work while that statement has focus).
    form.addEventListener("keydown", (e) => {
      const k = e.key.toLowerCase();
      if ((k !== "y" && k !== "n") || e.ctrlKey || e.metaKey || e.altKey) return;
      const fs = (e.target as HTMLElement).closest<HTMLElement>("fieldset.question");
      const radio = fs?.querySelector<HTMLInputElement>(`input[value="${k === "y" ? "yes" : "no"}"]`);
      if (!fs || !radio) return;
      e.preventDefault();
      radio.focus();
      if (radio.checked) return;
      radio.checked = true;
      keyed = `${k === "y" ? "Yes" : "No"} for statement ${parseInt(fs.querySelector(".question__num")?.textContent ?? "", 10)}. `;
      radio.dispatchEvent(new Event("change", { bubbles: true }));
    });
    // The deliberate step the brief asks for: the engine treats a missing answer as favorable, so unticked must become an explicit "no".
    form.addEventListener("click", (e) => {
      if (!(e.target as Element).closest("#done-btn")) return;
      const wasComplete = isComplete(d);
      const rest = d.questions.filter((q) => !draft.answers[q.id]);
      rest.forEach((q) => {
        draft.answers[q.id] = "no";
        missing.delete(q.id);
        const state = document.getElementById(`${q.id}-state`);
        if (state) state.textContent = noState(q.id);
      });
      saveDraft(draft);
      $("#done-error")!.hidden = true;
      $("#done-btn")!.removeAttribute("aria-describedby");
      $("#error-summary")?.remove();
      saved(d, wasComplete, rest.length ? `Recorded No for ${plural(rest.length, "statement", "statements")} you did not tick. ` : "");
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      // Enter in the save or share panel (it sits in this form in One at a time view) must not move to the next area.
      if (document.activeElement?.closest("#draft-tools")) return;
      next(n);
    });
    $("#back-btn")!.addEventListener("click", () => {
      if (n === 1) location.assign("/"); else location.hash = String(n - 1);
    });
    $$<HTMLAnchorElement>("[data-jump]").forEach((a) => a.addEventListener("click", (e) => {
      e.preventDefault();
      const id = a.dataset.jump!;
      if (quick) { quick.goTo(id); return; }
      document.getElementById(`q-${id}`)?.scrollIntoView({ block: "center" });
      (document.getElementById(`${id}-yes`) ?? document.getElementById(`${id}-check`))?.focus({ preventScroll: true });
    }));
    // Presenter shortcut: answers from the synthetic sample B, so a demo can click through an area in seconds.
    $("#demo-fill")?.addEventListener("click", async () => {
      sampleAnswers ??= fetch("/content/sample_answers.json").then((r) => (r.ok ? r.json() : null)).then((j) => j?.answers ?? null).catch(() => null);
      const sample = await sampleAnswers;
      if (!sample) return;
      const wasComplete = isComplete(d);
      d.questions.forEach((q) => { if (sample[q.id]) { draft.answers[q.id] = sample[q.id]; missing.delete(q.id); } });
      saveDraft(draft);
      fillQuestions(d);
      saved(d, wasComplete, `Demo: filled ${plural(d.questions.length, "statement", "statements")} with sample answers. `);
    });

    if (here.length) focusEl($("#error-summary"));
    else if (moveFocus) { window.scrollTo(0, 0); focusEl($("#area-title")); }
  }

  const seg = (name: string, value: string, label: string, on: boolean) => `
    <label class="seg__opt"><input type="radio" name="${name}" value="${value}"${on ? " checked" : ""}><span class="seg__check" aria-hidden="true">${icon("check")}</span><span>${label}</span></label>`;

  /** "Next: <area>". Under 600px the area name is read out but not shown, so the button never wraps (the progress line names it). */
  const nextHtml = (name: string) => `<span>Next<span class="q-next-name">: ${esc(name)}</span></span>`;

  /** Statements, About text and the answer instructions for the current view and language. */
  function fillQuestions(d: Domain) {
    const check = view === "check";
    $("#questions")!.innerHTML = `
      ${spanish() ? `<p class="q-es-note" lang="es">${icon("info")}<span>Traducción automática revisada por el equipo; la versión oficial en inglés está disponible.</span></p>` : ""}
      ${view === "quick" ? '<div id="quick-host"></div>' : `<p class="q-instruct">${icon(check ? "list-checks" : "circle-check")}<span>${check
        ? tr("Tick each statement that is true for your organization today. Anything you leave unticked counts as No.",
          "Marque cada afirmación que sea cierta para su organización hoy. Lo que deje sin marcar cuenta como No.")
        : tr("Choose Yes or No for each statement. Yes means it is true for your organization today.",
          "Elija Yes o No para cada afirmación. Yes quiere decir que es cierta para su organización hoy.")}</span></p>${groupedStatements(d)}`}
      ${check ? `<div class="check-done">
        <p>Anything you did not tick will be saved as No. That is fine: every No is simply a place to grow.</p>
        <p class="field-error" id="done-error" hidden>${icon("alert")}<span>Before you go on, press the button below. It saves every statement you did not tick as No.</span></p>
        <button type="button" class="btn btn-secondary" id="done-btn">${icon("list-checks")}<span>Done: everything I didn't tick is a No</span></button>
      </div>` : ""}`;
    const i = domains.indexOf(d);
    quick = view === "quick" ? mountQuick($("#quick-host")!, {
      domain: d, answers: draft.answers, ladders, byId, spanish, stmt, helpFor,
      change: (apply, prefix) => {
        const wasComplete = isComplete(d);
        apply();
        missing.forEach((id) => { if (draft.answers[id]) missing.delete(id); });
        saveDraft(draft);
        saved(d, wasComplete, prefix);
      },
      cheer: cheerFor(d),
      // Teammate links (?area=) send the area back instead of moving on (draft.ts relabels the bar button the same way).
      nextHtml: new URLSearchParams(location.search).has("area") ? "<span>Send my answers back</span>"
        : i === domains.length - 1 ? "<span>Review and finish</span>" : nextHtml(domains[i + 1].name),
    }) : null;
    const t = spanish() ? es[d.id] : undefined;
    const about = $("#about-body")!;
    about.innerHTML = `<p>${esc(t?.about ?? d.about)}</p>${d.connects ? `<p>${esc(t?.connects ?? d.connects)}</p>` : ""}`;
    if (t) about.setAttribute("lang", "es"); else about.removeAttribute("lang");
    $("#view-legend")!.innerHTML = tr("How would you like to answer?", "¿Cómo prefiere responder?");
    $("#view-hint")!.innerHTML = tr("Pick any. Your answers stay the same if you switch.", "Elija cualquiera. Sus respuestas no cambian si cambia de forma.");
    $("#callout-text")!.textContent = view === "quick"
      ? "Choose Yes if the statement is true for your organization today, and No if it is not yet. The next one comes up by itself. Every No is simply a place to grow."
      : "Answer for how your organization works today, not how you hope it will be. Every No is simply a place to grow.";
  }

  /** Phones show a short status in the bar row; the full sentence stays in the live region for screen readers. */
  const shortStatus = (d: Domain) =>
    `<span class="q-bar__short" aria-hidden="true">Saved: ${d.questions.filter((q) => draft.answers[q.id]).length} of ${d.questions.length}</span>`;

  /** Update progress and the bar's polite status (the only live region for answer changes). */
  function saved(d: Domain, wasComplete: boolean, prefix = "") {
    updateProgress();
    const done = d.questions.filter((q) => draft.answers[q.id]).length;
    const ok = savedLocally();
    const msg = !ok
      ? "Your browser did not let us save on this device. Keep this page open until you finish."
      : !wasComplete && done === d.questions.length
        ? cheerFor(d)
        : `Saved on this device. ${done} of ${d.questions.length} answered in this area.`;
    const status = $("#save-status")!;
    status.querySelector(".q-bar__full")!.textContent = prefix + msg;
    status.querySelector(".q-bar__short")!.textContent = `Saved: ${done} of ${d.questions.length}`;
    // Not saved: phones show the full warning, not the short line.
    status.classList.toggle("is-warn", !ok);
  }

  /** Keep scroll-padding equal to the sticky bar so focused controls are never hidden behind it (WCAG 2.4.11). */
  function watchBar() {
    const bar = $("#q-bar");
    barObserver?.disconnect();
    if (!bar) return;
    const set = () => document.documentElement.style.setProperty("--qbar-h", `${Math.ceil(bar.getBoundingClientRect().height)}px`);
    set();
    barObserver = new ResizeObserver(set);
    barObserver.observe(bar);
  }

  // Fallback for browsers that ignore scroll-padding when moving focus: nudge the page if the bar covers the focused control.
  // Controls only: clicking a label can focus <main> (tabindex -1), whose bottom is the page bottom, and the nudge then
  // jumped the page to the end on every other answer.
  document.addEventListener("focusin", (e) => {
    const bar = $("#q-bar");
    const el = e.target as HTMLElement;
    if (!bar || bar.contains(el) || !el.matches("input, button, select, textarea, a[href], summary")) return;
    const target = el.closest(".answer, .check-item__row") ?? el;
    const overlap = target.getBoundingClientRect().bottom - bar.getBoundingClientRect().top + 12;
    if (overlap > 0) window.scrollBy({ top: overlap });
  });

  function updateProgress() {
    const a = answeredTotal(), t = totalQuestions();
    const pct = t ? Math.round((a / t) * 100) : 0;
    const bar = $<HTMLProgressElement>("#overall-progress");
    if (bar) { bar.value = a; bar.textContent = `${pct}%`; }
    const txt = $("#progress-text");
    if (txt) txt.textContent = `${a} of ${t} statements answered (${pct}%)`;
    const time = $("#time-left");
    if (time && current) {
      const left = current.questions.filter((q) => !draft.answers[q.id]).length;
      const min = Math.ceil((left * SECONDS_PER_STATEMENT) / 60);
      time.innerHTML = `${icon("clock")}<span>${left ? `About ${plural(min, "minute", "minutes")} left in ${esc(current.name)}` : `${esc(current.name)} is done`}</span>`;
    }
    // The area nav shows Completed as soon as the current area is fully answered.
    const nav = $(".area-stepper ol");
    if (nav && current) nav.innerHTML = stepper(domains.indexOf(current) + 1);
    // Streak: areas finished in a row from the first one. It rewards finishing, never the answers given.
    const streak = $("#area-streak");
    if (streak) {
      const open = domains.findIndex((x) => !isComplete(x));
      const k = open < 0 ? domains.length : open;
      streak.hidden = k === 0;
      streak.innerHTML = `${icon("flag")}<span>Streak: ${plural(k, "area", "areas")} done in a row</span>`;
    }
  }

  async function next(n: number) {
    const d = domains[n - 1];
    const unanswered = d.questions.filter((q) => !draft.answers[q.id]).map((q) => q.id);
    if (unanswered.length && view === "check") {
      // Checklist: unticked is not yet a "no"; ask for the deliberate Done step instead of listing every statement.
      $("#done-error")!.hidden = false;
      $("#done-btn")!.setAttribute("aria-describedby", "done-error");
      $("#done-btn")!.focus();
      return;
    }
    if (unanswered.length) {
      unanswered.forEach((id) => missing.add(id));
      render(n, false);
      return;
    }
    if (n < domains.length) { location.hash = String(n + 1); return; }
    // All answered: the finish screen first. Otherwise submit, and the server lists what is missing.
    if (answeredTotal() === totalQuestions()) { location.hash = "done"; return; }
    await submitAll();
  }

  /** "You answered all 72 statements": a pause before submit, with the areas covered. */
  function renderFinish() {
    const open = domains.findIndex((x) => !isComplete(x));
    if (open >= 0) { history.replaceState(null, "", `#${open + 1}`); render(open + 1, true); return; }
    current = null;
    quick = null;
    const t = totalQuestions();
    const lastName = domains[domains.length - 1].name;
    document.title = "Ready for your results · OCI Capacity Coach";
    root.innerHTML = `
      <div class="title-band">
        <span class="eyebrow">Step 2 of 3: Questionnaire</span>
        <h1 id="finish-title" tabindex="-1">You answered all ${t} statements</h1>
      </div>
      <div class="finish">
        <span class="quick-done__badge" aria-hidden="true">${icon("circle-check")}</span>
        <p class="finish__lead">That's the hard part. Your plan is next.</p>
        <h2 class="finish__h">What you covered</h2>
        <ul class="finish__areas" role="list">${domains.map((x) => `
          <li>${icon("circle-check")}<span><strong>${esc(x.name)}</strong> <span class="finish__count">${plural(x.questions.length, "statement", "statements")} answered</span></span></li>`).join("")}
        </ul>
        <p>When you choose See my results, we build your report and your plan. It takes a minute or two. You can still go back and change any answer first.</p>
      </div>
      <form id="area-form" novalidate>
        <p class="field-error" id="submit-error" role="alert" hidden></p>
        <div class="q-bar" id="q-bar">
          <button type="button" class="btn btn-secondary" id="back-btn">${icon("arrow-left")}<span class="q-bar__back-label">Back<span class="visually-hidden"> to ${esc(lastName)}</span></span></button>
          <p class="q-bar__status" id="save-status" role="status" aria-live="polite">${icon("circle-check")}<span class="q-bar__full">Saved on this device. All ${t} statements answered.</span><span class="q-bar__short" aria-hidden="true">Saved: ${t} of ${t}</span></p>
          <button type="submit" class="btn btn-primary" id="next-btn"><span>See my results</span>${icon("arrow-right")}</button>
        </div>
      </form>`;
    root.removeAttribute("aria-busy");
    watchBar();
    $("#area-form")!.addEventListener("submit", (e) => { e.preventDefault(); submitAll(); });
    $("#back-btn")!.addEventListener("click", () => { location.hash = String(domains.length); });
    window.scrollTo(0, 0);
    focusEl($("#finish-title"));
  }

  async function submitAll() {
    if (submitting) return;
    submitting = true;
    const btn = $<HTMLButtonElement>("#next-btn")!;
    const label = btn.querySelector("span")!;
    const before = label.innerHTML;
    btn.setAttribute("aria-disabled", "true");
    label.textContent = "Sending your answers";
    try {
      const { id } = await api.post<{ id: string }>("/assessments", {
        org_name: draft.org_name, org_url: draft.org_url, language: draft.language,
        domain_ids: draft.domain_ids, answers: draft.answers,
        org_meta: draft.org_meta ?? null, // W4: optional start-page details (program model, staff size, state)
        // W1 v1.0: who answered, social links to research, and the draft token for teammate "Answered by" roles.
        respondent: draft.respondent ?? null, org_links: draft.org_links ?? null, draft_token: draftToken(),
      });
      // Keep the organization details for next time; answers start fresh.
      clearDraft();
      saveDraft({ ...draft, answers: {} });
      location.assign(`/results/?id=${encodeURIComponent(id)}`);
    } catch (ex) {
      submitting = false;
      if (ex instanceof ApiError && ex.status === 400 && ex.body.missing?.length) {
        missing = new Set(ex.body.missing);
        ex.body.missing.forEach((id) => { delete draft.answers[id]; });
        saveDraft(draft);
        const first = domains.findIndex((x) => x.questions.some((q) => missing.has(q.id))) + 1;
        if (first >= 1 && String(first) !== location.hash.slice(1)) location.hash = String(first);
        else render(first || domains.length, false);
        return;
      }
      if (ex instanceof ApiError && ex.status === 400 && ex.body.errors) {
        // Organization details were rejected: send the person back to fix them.
        location.assign("/");
        return;
      }
      if (ex instanceof ApiError && ex.status === 401) {
        // The sign-in ended while answering. The answers are on this device: sign in and come straight back here.
        location.assign(`/login/?next=${encodeURIComponent(location.pathname + location.search + location.hash)}`);
        return;
      }
      btn.removeAttribute("aria-disabled");
      label.innerHTML = before;
      const why = !(ex instanceof ApiError) ? "We could not reach the server. Check your internet connection, then try again."
        : ex.status === 429 ? ex.body.error ?? "We have made as many reports as we can this hour. Please try again later."
        : "Something went wrong on our side. Please try again in a few minutes.";
      const err = $("#submit-error")!;
      err.innerHTML = `${icon("alert")}<span>${esc(why)} Your answers are saved on this device, so nothing is lost.</span>`;
      err.hidden = false;
      focusEl(err);
    }
  }

  async function init() {
    const json = (url: string) => fetch(url).then((r) => (r.ok ? r.json() : null)).catch(() => null);
    const content = Promise.all([json("/content/glossary.json"), json("/content/questions_es.json"), json("/content/ladders.json")]);
    const user = await requireUser();
    const asked = new URLSearchParams(location.search).get("demo") === "1";
    try {
      if (asked) localStorage.setItem(DEMO_KEY, "1");
      demo = user.name === "demo" && (asked || localStorage.getItem(DEMO_KEY) === "1");
    } catch { demo = user.name === "demo" && asked; }
    const meta = await getMeta();
    const d = await loadDraft();
    if (!d || !d.org_name || !d.domain_ids.length) { location.replace("/"); return; }
    draft = d;
    stages = meta.stages;
    const [terms, spanishText, ladderFile] = await content;
    glossary = (terms ?? []).map((g: { term: string; plain: string; example: string }) =>
      ({ ...g, re: new RegExp(`\\b${g.term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\b`, "i") }));
    es = spanishText ?? {};
    if (draft.language === "es" && Object.keys(es).length) qlang = "es";
    domains = d.domain_ids.map((id) => meta.domains.find((x) => x.id === id)).filter((x): x is Domain => !!x);
    if (!domains.length) { location.replace("/"); return; }
    byId = new Map(domains.flatMap((x) => x.questions.map((q) => [q.id, { q, area: x.name }] as const)));
    ladders = scopeLadders(ladderFile?.ladders ?? [], new Set(byId.keys()));
    // No step in the link (a resume link, the start page): open the first area that still needs answers.
    if (!location.hash) {
      const open = domains.findIndex((x) => !isComplete(x));
      history.replaceState(null, "", open < 0 ? "#done" : `#${open + 1}`);
    }
    if (location.hash === "#done") renderFinish(); else render(stepFromHash(), false);
    // Only numeric hashes (and #done) are steps; the skip link (#main) must not re-render the page.
    window.addEventListener("hashchange", () => {
      if (location.hash === "#done") renderFinish();
      else if (/^#\d+$/.test(location.hash)) render(stepFromHash(), true);
    });
  }

  init().catch((ex) => {
    root.removeAttribute("aria-busy");
    document.title = "Questionnaire · OCI Capacity Coach";
    root.innerHTML = ex instanceof DraftLinkError
      ? `<div class="title-band"><h1 id="q-error" tabindex="-1">This teammate link does not work anymore</h1></div>
        <div class="card stack"><p>It may be old, or part of it may be missing. Ask the person who sent it to make a new one with <strong>Send this area to a teammate</strong>.</p>
        <p><a href="/">Go to the start page</a></p></div>`
      : `<div class="title-band"><h1 id="q-error" tabindex="-1">We could not load the questions</h1></div>
        <p class="field-error" role="alert">${icon("alert")}<span>Check your internet connection, then reload the page. Any answers you gave are saved on this device.</span></p>`;
    focusEl($("#q-error"));
  });
</script>
