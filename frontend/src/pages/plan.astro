---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Your roadmap" width="report">
  <div id="plan-root" aria-busy="true">
    <p class="loading"><Icon name="loader" class="spin" />Loading your roadmap</p>
  </div>
</Base>

<script>
  import { ApiError, requireUser } from "../lib/api";
  import { $, esc } from "../lib/dom";
  import { icon } from "../lib/icons";
  import { mountPlan } from "../lib/roadmap";

  const root = $("#plan-root")!;
  const id = new URLSearchParams(location.search).get("id") || "";

  function fail(title: string, text: string, reload = false, report = !!id) {
    root.removeAttribute("aria-busy");
    document.title = `${title} · OCI Capacity Coach`;
    root.innerHTML = `<h1>${esc(title)}</h1><p class="notice">${icon("alert")}<span>${esc(text)}</span></p>
      <p class="actions actions--start">${reload ? `<a class="btn btn-primary" href="${esc(location.href)}">${icon("refresh")}<span>Reload the page</span></a>` : ""}${report ? `<a href="/results/?id=${encodeURIComponent(id)}">Go to the report</a>` : ""}<a href="/">Go to the start page</a></p>`;
  }

  requireUser().then(async () => {
    if (!id) return fail("Roadmap not found", "This link is missing the report id.");
    try {
      await mountPlan(root, id);
    } catch (ex) {
      if (ex instanceof ApiError && ex.status === 404) return fail("Report not found", "We could not find this report. It may belong to another account, or the link may be incomplete.", false, false);
      if (ex instanceof ApiError && [403, 409].includes(ex.status)) return fail("Roadmap not available", ex.message);
      fail("Something went wrong", "We could not load your roadmap. Check your connection, then reload the page.", true);
    }
  });
</script>
