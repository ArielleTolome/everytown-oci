---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Your report" width="report">
  <div id="results-root" aria-busy="true">
    <p class="loading"><Icon name="loader" class="spin" />Loading your report</p>
  </div>
</Base>

<script>
  import { api, ApiError, getMeta, requireUser, type Assessment, type Meta, type StatusResponse, type User } from "../lib/api";
  import { $, announce, esc, focusEl } from "../lib/dom";
  import { wireCoach } from "../lib/coach";
  import { wireListen } from "../lib/listen";
  import { icon } from "../lib/icons";
  import { pdfButton, reportBody, respondentLine, statusPanel, STATE_TEXT, stepItems, wireChecklists, wireExplore, wireLayers, wireOwnerOnly, wirePeers, wireReminder, wireSupport } from "../lib/results";
  import { wireFeedback } from "../lib/feedback";
  import { wireOptin } from "../lib/optin";
  import { errorText, wireDownloads } from "../lib/report-ui";
  import { getRoadmap, wireRoadmapTeaser } from "../lib/roadmap";
  import { wireToc } from "../lib/toc";

  const root = $("#results-root")!;
  const id = new URLSearchParams(location.search).get("id") || "";
  let meta: Meta;
  let user: User;
  let pollTimer = 0;
  let pollStart = 0;
  // After this long without a result, say so plainly instead of spinning forever.
  const SLOW_MS = 120_000;

  function render(sub: Assessment, focus: "ready" | "error" | null) {
    const staff = user.role === "staff";
    const who = respondentLine(sub);
    // A report that just finished opens on "Your plan", where the ready notice points.
    if (focus === "ready") history.replaceState(null, "", location.pathname + location.search);
    document.title = `${sub.status === "done" ? "Your report is ready" : sub.status === "error" ? "Report paused" : "Building your recommendations"}: ${sub.org_name} · OCI Capacity Coach`;
    // Fresh container per render so listeners never stack up across re-renders.
    const view = document.createElement("div");
    view.innerHTML = `
      <div class="title-band">
        ${staff ? `<p><a href="/staff/">${icon("arrow-left")} Back to staff dashboard</a></p>` : ""}
        <span class="eyebrow">${staff ? "Organization report (staff view)" : "Step 3 of 3: Your report"}</span>
        <div class="report-head">
          <div>
            <h1>${esc(sub.org_name)}: capacity report</h1>
            <p class="meta">Created ${esc(sub.created)} · ${sub.domains.length} capacity area${sub.domains.length === 1 ? "" : "s"}${sub.org_url ? ` · ${esc(sub.org_url)}` : ""}</p>
            ${who ? `<p class="meta respondent-line">${icon("user")}<span>Completed by: <strong>${esc(who)}</strong></span></p>` : ""}
          </div>
          ${sub.status === "done" ? `<div class="actions">${pdfButton(sub)}</div>` : ""}
        </div>
      </div>
      <div class="report-layout">
        <nav class="toc" aria-label="On this page" id="toc"></nav>
        <div class="report-main" id="report-main">
          ${statusPanel(sub)}
          ${reportBody(sub, meta, { reminder: !staff, support: !staff && !!sub.report, staff })}
          ${staff ? "" : `<p class="section-gap"><a href="/">${icon("refresh")} Start a new assessment</a></p>`}
        </div>
      </div>`;
    root.replaceChildren(view);
    root.removeAttribute("aria-busy");
    wireListen(sub.id, view);
    wireCoach(sub, view);
    // One roadmap request feeds Start here, the roadmap teaser and the owner-only forms.
    const roadmap = sub.report ? getRoadmap(sub.id) : null;
    wireChecklists(sub, view, roadmap);
    wireOwnerOnly(view, roadmap);
    wireReminder(sub, view);
    wireSupport(sub, view);
    wirePeers(sub, view);
    wireOptin(sub, view, staff);
    wireFeedback(sub, view, staff);
    wireExplore(sub, meta, view);
    wireLayers(view);
    wireDownloads(view);
    const teaser = $("#roadmap-section", view);
    if (teaser) wireRoadmapTeaser(teaser, roadmap);
    wireToc($("#toc")!, $("#report-main")!);
    $<HTMLButtonElement>("#retry-btn")?.addEventListener("click", retry);
    if (focus === "ready") focusEl($("#ready"));
    if (focus === "error") focusEl($("#processing-title"));
    if (sub.status === "running") {
      pollStart ||= Date.now();
      schedulePoll();
    }
  }

  function schedulePoll() {
    window.clearTimeout(pollTimer);
    pollTimer = window.setTimeout(poll, 2000);
  }

  async function poll() {
    let data: StatusResponse;
    try {
      data = await api.get<StatusResponse>(`/assessments/${encodeURIComponent(id)}/status`);
    } catch (ex) {
      if (ex instanceof ApiError && ex.status === 401) { await requireUser(); return; } // sends the reader to sign in
      pollTimer = window.setTimeout(poll, 4000);
      return;
    }
    if (Date.now() - pollStart > SLOW_MS) $("#processing-slow")?.removeAttribute("hidden");
    if (data.status === "done" || data.status === "error") {
      let sub: Assessment;
      try {
        sub = await api.get<Assessment>(`/assessments/${encodeURIComponent(id)}`);
      } catch {
        pollTimer = window.setTimeout(poll, 4000);
        return;
      }
      announce(sub.status === "done" ? "Your report is ready." : "We could not finish your recommendations.");
      render(sub, sub.status === "done" ? "ready" : "error");
      return;
    }
    // Update only changed steps; announce transitions, not every poll.
    const changes: string[] = [];
    const list = $("#step-list");
    for (const s of data.steps) {
      const li = list?.querySelector<HTMLElement>(`[data-step="${CSS.escape(s.key)}"]`);
      if (!li || li.dataset.state === s.state) continue;
      li.outerHTML = stepItems([s]);
      changes.push(`${s.label}: ${STATE_TEXT[s.state].toLowerCase()}.`);
    }
    if (changes.length) announce(changes.join(" "));
    schedulePoll();
  }

  async function retry(e: Event) {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.setAttribute("aria-disabled", "true");
    try {
      await api.post(`/assessments/${encodeURIComponent(id)}/retry`);
      const sub = await api.get<Assessment>(`/assessments/${encodeURIComponent(id)}`);
      announce("Trying again. Building your recommendations.");
      pollStart = 0;
      render(sub, null);
      focusEl($("#processing-title"));
    } catch (ex) {
      btn.removeAttribute("aria-disabled");
      const err = $("#retry-error");
      if (err) {
        err.innerHTML = `${icon("alert")}<span>${esc(errorText(ex, "We could not restart. Please try again."))}</span>`;
        err.hidden = false;
      }
    }
  }

  function fail(title: string, text: string, reload = false) {
    root.removeAttribute("aria-busy");
    document.title = `${title} · OCI Capacity Coach`;
    root.innerHTML = `<h1>${esc(title)}</h1><p class="notice">${icon("alert")}<span>${esc(text)}</span></p>
      <p class="actions actions--start">${reload ? `<a class="btn btn-primary" href="${esc(location.href)}">${icon("refresh")}<span>Reload the page</span></a>` : ""}<a href="/">Go to the start page</a></p>`;
  }

  async function init() {
    user = await requireUser();
    if (!id) { fail("Report not found", "This link is missing the report id."); return; }
    meta = await getMeta();
    let sub: Assessment;
    try {
      sub = await api.get<Assessment>(`/assessments/${encodeURIComponent(id)}`);
    } catch (ex) {
      if (ex instanceof ApiError && (ex.status === 404 || ex.status === 403)) {
        fail("Report not found", "We could not find this report. It may belong to another account, or the link may be incomplete.");
        return;
      }
      throw ex;
    }
    render(sub, null);
  }

  init().catch(() => fail("Something went wrong", "We could not load this report. Check your connection, then reload the page.", true));
</script>
