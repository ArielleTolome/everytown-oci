---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Sign in" width="narrow" public>
  <div class="title-band">
    <span class="eyebrow">Welcome</span>
    <h1>Sign in to OCI Capacity Coach</h1>
    <p class="lead">Someone in a leadership role should fill out the assessment, like the executive director, a finance lead or a board chair. Other leaders are welcome too.</p>
    <p class="notice" id="next-note" hidden><Icon name="info" /><span></span></p>
  </div>
  <div class="card card--auth">
    <div class="notice">
      <Icon name="info" />
      <div>
        <p>Demo environment: use the provided test credentials.</p>
        <ul class="demo-creds">
          <li>Organization leader: <code>demo</code> / <code>demo</code></li>
          <li>Presentation, start page already filled in: <code>showcase</code> / <code>showcase</code></li>
          <li>Everytown staff: <code>staff</code> / <code>staff</code></li>
        </ul>
      </div>
    </div>
    <noscript><p class="notice"><Icon name="info" /><span>Signing in needs JavaScript. Turn it on in your browser settings, then reload the page.</span></p></noscript>
    {/* method="post": if the script never runs, the password does not end up in the address bar. */}
    <form class="stack" id="login-form" method="post" novalidate>
      <div class="field">
        <label for="username">Username</label>
        <input class="input" type="text" id="username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" enterkeyhint="next" required>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <div class="input-group">
          <input class="input" type="password" id="password" name="password" autocomplete="current-password" autocapitalize="none" spellcheck="false" enterkeyhint="go" required>
          <button type="button" class="btn btn-secondary btn-icon" id="toggle-password" aria-label="Show password" aria-pressed="false"><Icon name="eye" /></button>
        </div>
      </div>
      <p class="field-error" id="login-error" role="alert" hidden></p>
      <div class="actions">
        <button type="submit" class="btn btn-primary"><Icon name="lock" /><span>Sign in</span></button>
      </div>
    </form>
  </div>
  <p class="resume-cta"><a href="/login/?next=%2Fresume%2F"><Icon name="refresh" /><span>Continue an assessment you started</span></a> <span class="hint">Sign in, then paste your saved link.</span></p>
</Base>

<script>
  import { api, ApiError, type User } from "../lib/api";
  import { $ } from "../lib/dom";
  import { icon } from "../lib/icons";

  const form = $<HTMLFormElement>("#login-form")!;
  const user = $<HTMLInputElement>("#username")!;
  const pass = $<HTMLInputElement>("#password")!;
  const err = $("#login-error")!;
  const toggle = $<HTMLButtonElement>("#toggle-password")!;

  const params = new URLSearchParams(location.search);
  const nextUrl = (role: User["role"]) => {
    const next = params.get("next");
    // Same-site paths only. Resolve first: browsers read "/\host" as "//host", so a prefix check is not enough (#1).
    try {
      const url = next?.startsWith("/") ? new URL(next, location.origin) : null;
      if (url && url.origin === location.origin && !url.pathname.startsWith("/login/")) return url.pathname + url.search + url.hash;
    } catch { /* not a URL: use the default page */ }
    return role === "staff" ? "/staff/" : "/";
  };

  // Sent here from another page (an expired sign-in, a saved link): say where they will land, and that answers are safe.
  const next = params.get("next");
  if (next && next !== "/" && nextUrl("org") === next) {
    const note = $("#next-note")!;
    note.querySelector("span")!.textContent = next.startsWith("/questionnaire/")
      ? "Sign in to keep going with your assessment. Any answers you gave are saved on this device."
      : "Sign in to go back to the page you were on.";
    note.hidden = false;
  }

  // Already signed in? Go straight on.
  api.get<{ user: User }>("/me").then(({ user }) => location.replace(nextUrl(user.role))).catch(() => { /* not signed in */ });

  toggle.addEventListener("click", () => {
    const show = pass.type === "password";
    pass.type = show ? "text" : "password";
    toggle.setAttribute("aria-pressed", String(show));
    toggle.setAttribute("aria-label", show ? "Hide password" : "Show password");
  });

  // Mark only the fields in error (#17); a wrong username or password marks both.
  const showError = (msg: string, bad = [user, pass]) => {
    err.innerHTML = `${icon("alert")}<span></span>`;
    err.querySelector("span")!.textContent = msg;
    err.hidden = false;
    for (const el of [user, pass]) {
      if (bad.includes(el)) { el.setAttribute("aria-invalid", "true"); el.setAttribute("aria-describedby", "login-error"); }
      else { el.removeAttribute("aria-invalid"); el.removeAttribute("aria-describedby"); }
    }
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    // Enter in Username with no password yet is "Next" on a phone keyboard: go to Password, no error.
    if (document.activeElement === user && user.value.trim() && !pass.value) { pass.focus(); return; }
    const empty = [user, pass].filter((el) => !(el === user ? el.value.trim() : el.value));
    if (empty.length) {
      showError(empty.length === 2 ? "Enter your username and password." : empty[0] === user ? "Enter your username." : "Enter your password.", empty);
      empty[0].focus();
      return;
    }
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    if (btn.getAttribute("aria-disabled") === "true") return; // already signing in
    btn.setAttribute("aria-disabled", "true");
    try {
      const { user: u } = await api.post<{ user: User }>("/login", { username: user.value.trim(), password: pass.value });
      location.assign(nextUrl(u.role));
    } catch (ex) {
      showError(ex instanceof ApiError && ex.status === 401
        ? "That username or password did not match. Check the demo sign-in details above and try again."
        : ex instanceof ApiError ? "Something went wrong on our side. Please try again in a few minutes."
        : "We could not reach the server. Check your internet connection, then try again.");
      pass.focus();
    } finally {
      btn.removeAttribute("aria-disabled");
    }
  });
</script>
